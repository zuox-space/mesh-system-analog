generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              Int      @id @default(autoincrement())
  sub             String   @unique
  email           String?  @unique
  passwordHash    String
  role            String   @default("TEACHER")
  accessStatus    String   @default("PENDING")
  firstName       String?
  lastName        String?
  middleName      String?
  profileId       BigInt?
  extensionToken  String?  @unique              // постоянный токен расширения
  pairCode        String?                       // текущий пин-код
  pairCodeExpires DateTime?                     // когда сгорает пин-код
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tokens          Token[]
  logs            LogEntry[]
}

model Token {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  issuedAt   DateTime?
  expiresAt  DateTime?
  grantedAt  DateTime @default(now())
  revokedAt  DateTime?
  isActive   Boolean  @default(true)

  @@index([userId])
}

model LogEntry {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}