generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              Int      @id @default(autoincrement())
  sub             String   @unique
  email           String?  @unique
  passwordHash    String
  role            String   @default("TEACHER")
  accessStatus    String   @default("PENDING")
  firstName       String?
  lastName        String?
  middleName      String?
  profileId       BigInt?
  extensionToken  String?  @unique              // постоянный токен расширения
  pairCode        String?                       // текущий пин-код
  pairCodeExpires DateTime?                     // когда сгорает пин-код
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tokens          Token[]
  logs            LogEntry[]

    lessonPlan  LessonPlan?

}

model Token {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  issuedAt   DateTime?
  expiresAt  DateTime?
  grantedAt  DateTime @default(now())
  revokedAt  DateTime?
  isActive   Boolean  @default(true)

  @@index([userId])
}

model LogEntry {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model LessonPlan {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id])
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lessons    PlannedLesson[]
}

model PlannedLesson {
  id              Int      @id @default(autoincrement())
  planId          Int
  plan            LessonPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  date            String   // YYYY-MM-DD
  time            String   // HH:MM
  startAt         DateTime // полная дата+время
  groupId         Int
  groupName       String
  subjectId       Int
  subjectName     String
  lessonName      String
  lessonTemplateId Int?    // ID шаблона uchebnik
  launchUrl       String   // ссылка на запуск
  status          String   @default("pending") // pending | running | finished | failed
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([planId, startAt])
  @@index([status])
}