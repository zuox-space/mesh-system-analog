{
  "manifest_version": 3,
  "name": "MESH Token Helper",
  "version": "1.3",
  "description": "Передаёт токен МЭШ в приложение научного руководителя",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://school.mos.ru/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MESH Token"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}