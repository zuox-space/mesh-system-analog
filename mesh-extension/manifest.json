{
  "manifest_version": 3,
  "name": "MESH Helper",
  "version": "3.1.0",
  "description": "Полный аналог web-панели МЭШ",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://school.mos.ru/*",
    "https://uchebnik.mos.ru/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MESH Helper"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}