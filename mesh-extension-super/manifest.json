{
  "manifest_version": 3,
  "name": "Помощник в МЭШ",
  "version": "3.3.0",
  "description": "Автономный помощник МЭШ: расписание, ДЗ, КТП, автозапуск уроков",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://school.mos.ru/*",
    "https://uchebnik.mos.ru/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Помощник в МЭШ"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://school.mos.ru/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "https://school.mos.ru/*"
      ]
    }
  ]
}